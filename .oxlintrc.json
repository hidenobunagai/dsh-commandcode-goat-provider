{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-expressions": "error"
  },
  "ignorePatterns": ["lib/**", "node_modules/**", "**/*.config.ts"],
  "overrides": []
}
